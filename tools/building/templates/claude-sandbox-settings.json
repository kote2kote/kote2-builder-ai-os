{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "./**/.env",
        "./**/.env.*",
        "./**/.envrc",
        "./**/.dev.vars",
        "./**/.dev.vars.*",
        "./**/*.pem",
        "./**/*.key",
        "./**/credentials.json",
        "./**/service-account*.json",
        "./**/.npmrc",
        "./**/.pypirc",
        "./**/.netrc",
        "~/.ssh/**",
        "~/.aws/**",
        "~/.cloudflared/**",
        "~/.config/gcloud/**",
        "~/.kube/**",
        "~/.codex/auth.json",
        "~/.claude/.credentials.json"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "CLOUDFLARE_API_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com"
      ]
    }
  }
}
