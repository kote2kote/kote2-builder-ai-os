{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.prod*)",
      "Read(.env.dev*)",
      "Read(.env.stag*)",
      "Read(.env.test*)",
      "Read(.env.preview*)",
      "Read(.envrc)",
      "Read(.dev.vars)",
      "Read(.dev.vars.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.cloudflared/**)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git clean *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)"
    ]
  }
}
