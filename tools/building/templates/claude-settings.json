{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.prod*)",
      "Read(**/.env.dev*)",
      "Read(**/.env.stag*)",
      "Read(**/.env.test*)",
      "Read(**/.env.preview*)",
      "Read(**/.envrc)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.cloudflared/**)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git clean *)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.netrc)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.envrc)",
      "Edit(**/.dev.vars)",
      "Edit(**/.dev.vars.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/credentials.json)",
      "Edit(**/service-account*.json)",
      "Edit(**/.npmrc)",
      "Edit(**/.pypirc)",
      "Edit(**/.netrc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.cloudflared/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.codex/auth.json)",
      "Edit(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)"
    ]
  }
}
