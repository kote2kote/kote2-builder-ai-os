# ============================================================
# n8n(このマシン専用)の設定 — .env のひな型。これは共有して OK
# 本物は scripts/setup.sh が .env としてコピーして作ります。
# ★このブロックの値はマシンごとに違う。別のマシンや別の人の値を使い回さない
# コメントは行頭に書く(値の後ろに書かない)
# ============================================================

# 公開 URL(このマシン専用のサブドメイン。他のマシンの n8n と同じ名前にしない)
N8N_HOST={{N8N_HOST}}

# Cloudflare 上のトンネル名(1 台に 1 つ。他のマシンと共有しない)
TUNNEL_NAME={{TUNNEL_NAME}}

# Claude Code に登録する MCP サーバーの名前(マシンごとに変える)
MCP_NAME={{MCP_NAME}}

# このマシンでの n8n の名前(Docker のコンテナ名。同じマシンの他の n8n と重ねない)
N8N_INSTANCE={{N8N_INSTANCE}}

# データの置き場(Docker のボリューム名。消すとワークフローも認証情報も消える)
N8N_VOLUME={{N8N_VOLUME}}

# 手元で待ち受けるポート(このマシンで使われていない番号)
N8N_LOCAL_PORT={{N8N_LOCAL_PORT}}

# n8n のバージョン(固定。上げる時はここを書き換えて up.sh)
N8N_VERSION={{N8N_VERSION}}

# 暗号化キー(setup.sh が自動生成。一度決めたら変えない。変えると保存済みの認証情報が読めなくなる)
N8N_ENCRYPTION_KEY=

# n8n API キー(n8n の Settings > n8n API で発行して、本人がここに貼る。チャットには貼らない)
N8N_API_KEY=
